{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    }
  },
  "AWS": {
    "Region": "us-east-1",
    "ServiceUrl": "http://localhost:4566",
    "SqsQueueUrl": "http://localhost:4566/000000000000/populator-queue",
    "SnsTopicArn": "arn:aws:sns:us-east-1:000000000000:material-events"
  },
  "Services": {
    "MaterialsApiUrl": "http://localhost:4566/_aws/execute-api/material-api/prod/"
  },
  "Otel": {
    "Protocol": "http",
    "Endpoint": "http://otel-collector:4318",
    "Environment": "development"
  },
  "FeatureFlags": {
    "Provider": "Unleash",
    "UnleashApiUrl": "http://unleash:4242/api/",
    "UnleashApiKey": "*:development.unleash-insecure-api-token",
    "UnleashAppName": "poc-app",
    "UnleashInstanceId": "unleash-init"
  }
}
