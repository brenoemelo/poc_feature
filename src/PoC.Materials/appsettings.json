{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "AWS": {
    "Region": "us-east-1",
    "ServiceUrl": "http://localhost:4566"
  },
  "Materials": {
    "TableName": "materials-table"
  },
  "Otel": {
    "Protocol": "http",
    "Endpoint": "http://otel-collector:4318",
    "Environment": "development"
  },
  "FeatureFlags": {
    "Provider": "Unleash",
    "UnleashApiUrl": "http://unleash:4242/api/",
    "UnleashApiKey": "*:development.unleash-insecure-api-token",
    "UnleashAppName": "poc-app",
    "UnleashInstanceId": "unleash-init",
    "FetchTogglesIntervalSeconds": 1
  }
}
