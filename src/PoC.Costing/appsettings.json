{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "AWS": {
    "Region": "us-east-1"
  },
  "Otel": {
    "Protocol": "http",
    "Endpoint": "http://otel-collector:4318",
    "Environment": "development"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "FeatureFlags": {
    "Provider": "Unleash",
    "UnleashApiUrl": "http://fake-unleash/api/",
    "UnleashApiKey": "*:development.unleash-insecure-api-token",
    "UnleashAppName": "poc-app",
    "UnleashInstanceId": "unleash-init"
  },
  "MATERIALS_API_URL": "http://localhost:4566/restapis/material-api/prod/_user_request_"
}