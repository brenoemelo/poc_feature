# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
Otel__Endpoint=http://otel-collector:4318
Otel__Protocol=http/protobuf
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# Feature Flags Configuration (Unleash)
FeatureFlags__Provider=Unleash
FeatureFlags__UnleashApiUrl=http://unleash:4242/api/
FeatureFlags__UnleashApiKey=*:development.unleash-insecure-api-token
FeatureFlags__UnleashAppName=poc-app
FeatureFlags__UnleashInstanceId=local-lambda
FeatureFlags__FetchTogglesIntervalSeconds=1
FeatureFlags__TimeoutSeconds=10

# AWS Configuration (LocalStack)
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
