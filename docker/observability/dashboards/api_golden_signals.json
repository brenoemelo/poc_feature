    "panels": [
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (http_route) (rate(http_server_request_duration_count{service_name=~\"$service\"}[1m]))",
                    "legendFormat": "{{http_route}}",
                    "refId": "A"
                }
            ],
            "title": "Request Rate (RPS)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 0
            },
            "id": 2,
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(http_server_request_duration_count{error_type!=\"\", service_name=~\"$service\"}[1m])) / sum(rate(http_server_request_duration_count{service_name=~\"$service\"}[1m])) * 100",
                    "legendFormat": "Error Rate %",
                    "refId": "A"
                }
            ],
            "title": "Error Rate (%)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 0
            },
            "id": 3,
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (le) (rate(http_server_request_duration_bucket{service_name=~\"$service\"}[1m]))",
                    "format": "heatmap",
                    "refId": "A"
                }
            ],
            "title": "Latency Heatmap",
            "type": "heatmap"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 8
            },
            "id": 4,
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le, peer_service) (rate(http_client_request_duration_bucket{service_name=~\"$service\"}[1m])))",
                    "legendFormat": "{{peer_service}} (External API/Service)",
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_operation_duration_bucket{service_name=~\"$service\"}[1m])))",
                    "legendFormat": "DynamoDB/Database",
                    "refId": "B"
                }
            ],
            "title": "Dependency Latency (P95)",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "gridPos": {
                "h": 10,
                "w": 24,
                "x": 0,
                "y": 16
            },
            "id": 5,
            "options": {
                "showTime": true,
                "sortOrder": "Descending"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "{service_name=~\"$service\"} |= `error`",
                    "refId": "A"
                }
            ],
            "title": "API Error Logs",
            "type": "logs"
        }
    ],
