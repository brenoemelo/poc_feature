            "options": {
                "title": "Slowest Spans"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "tempo",
                        "uid": "tempo"
                    },
                    "limit": 20,
                    "query": "{ span.duration > 200ms } | select(.duration, .status, .service.name, .name) | order_by(.duration, desc)",
