            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "editorMode": "code",
                    "expr": "sum(rate(http_server_request_duration_count{service_name=~\"$service\", http_status_code=~\"2..|3..\"}[5m])) / sum(rate(http_server_request_duration_count{service_name=~\"$service\"}[5m])) * 100",
                    "legendFormat": "__auto",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Global Availability",
            "type": "stat",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 99
                            },
                            {
                                "color": "green",
                                "value": 99.9
                            }
                        ]
                    },
                    "unit": "percent"
                },
                "overrides": []
            }
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "id": 2,
            "options": {
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true,
                "text": {}
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "100 - (sum(rate(http_server_request_duration_count{service_name=~\"$service\", http_status_code=~\"5..\"}[30d])) / sum(rate(http_server_request_duration_count{service_name=~\"$service\"}[30d])) * 100)",
                    "legendFormat": "Error Budget Remaining",
                    "refId": "A"
                }
            ],
            "title": "Global Error Budget (Monthly)",
            "type": "gauge",
            "fieldConfig": {
                "defaults": {
                    "max": 100,
                    "min": 0,
                    "unit": "percent"
                }
            }
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 12,
                "x": 12,
                "y": 0
