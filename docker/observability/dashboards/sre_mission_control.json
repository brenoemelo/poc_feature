                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "topk(10, histogram_quantile(0.99, sum by (peer_service, le) (rate(http_client_request_duration_bucket{service_name=~\"$service\"}[5m]))))",
                    "format": "table",
                    "legendFormat": "{{peer_service}}",
                    "refId": "A"
                }
            ],
            "title": "Slowest Dependencies (P99)",
            "type": "table"
        },
        {
            "datasource": {
