            "id": 3,
            "title": "Active Alerts",
            "type": "table",
            "targets": [
                {
                    "expr": "ALERTS{alertstate=\"firing\"}",
                    "format": "table"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 6
            },
            "id": 4,
            "options": {
                "displayMode": "gradient",
