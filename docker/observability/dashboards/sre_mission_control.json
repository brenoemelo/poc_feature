                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(http_server_request_duration_count{http_status_code=~\"5..\", service_name=~\"$service\"}[1m]))",
                    "format": "heatmap",
                    "refId": "A"
                }
            ],
            "title": "Error Rate Distribution (Heatmap)",
            "type": "heatmap"
        },
        {
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 6
            },
            "id": 6,
