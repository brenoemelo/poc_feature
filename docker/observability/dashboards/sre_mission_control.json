                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showUnfilled": true
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "topk(5, sum by (service_name) (rate(http_server_request_duration_count{http_status_code=~\"5..\", service_name=~\"$service\"}[5m])))",
                    "legendFormat": "{{service_name}}",
                    "refId": "A"
                }
            ],
            "title": "Top 5 Failing Services (5xx)",
            "type": "bargauge",
            "fieldConfig": {
                "defaults": {
                    "links": [
                        {
                            "title": "Drill-down to Service",
                            "url": "/d/api-signals/c-api-golden-signals?var-service=${__field.labels.service_name}"
                        }
                    ]
                }
            }
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
