            "targets": [
                {
                    "datasource": {
                        "type": "tempo",
                        "uid": "tempo"
                    },
                    "limit": 20,
                    "query": "{ status = error } | select(.duration, .status, .service.name, .name) | order_by(.duration, desc)",
                    "queryType": "traceql",
                    "refId": "A"
                }
            ],
            "title": "Detailed Investigation (Traces with Error)",
            "type": "table"
        }
